# PATCH environment configuration — PLACEHOLDERS ONLY.
# Copy to .env.local for local overrides (never commit real secrets).
# The app runs fully in LOCAL MODE with NONE of these set.

# ---------------------------------------------------------------------------
# Mode selection
# ---------------------------------------------------------------------------
# Persistence adapter: "local" (default, JSON file) | "dynamo"
PATCH_PERSISTENCE=local
# AI provider: "local" (default, deterministic) | "bedrock"
PATCH_AI_PROVIDER=local
# Force dev tools (user switcher + reset) on even in production builds. Keep OFF in real prod.
# PATCH_DEV_TOOLS=0

# ---------------------------------------------------------------------------
# Matching (optional overrides)
# ---------------------------------------------------------------------------
# JSON object; keys: semantic,time,location,compatibility,condition (should sum to 1.0)
# PATCH_MATCH_WEIGHTS={"semantic":0.3,"time":0.25,"location":0.2,"compatibility":0.15,"condition":0.1}

# ---------------------------------------------------------------------------
# AWS mode — ONLY needed when PATCH_PERSISTENCE=dynamo or PATCH_AI_PROVIDER=bedrock.
# In deployed workloads prefer IAM ROLES over static keys; do NOT hard-code keys here.
# ---------------------------------------------------------------------------
# AWS_REGION=us-east-1

# DynamoDB (single-table). Create via the CDK stack in /infra.
# PATCH_DDB_TABLE=patch

# Bedrock. Verify the model is enabled in your account/region before setting this;
# do not assume a model id. Example (Anthropic Claude on Bedrock):
# PATCH_BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0

# Optional SNS topic for request notifications (stretch).
# PATCH_SNS_TOPIC_ARN=
